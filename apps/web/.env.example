# Environment Variables
# Copy this file to .env and fill in the values

# WalletConnect Cloud project ID for wallet connections (required)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Application name displayed in wallet dialogs
NEXT_PUBLIC_APP_NAME=My DApp

# Alchemy API key for fetching onchain activity (required)
ALCHEMY_API_KEY=

# Network for onchain activity (arbitrum or arbitrum-sepolia) (required)
NEXT_PUBLIC_ONCHAIN_NETWORK=arbitrum

# Dune Analytics API key for blockchain data queries (required) [secret]
DUNE_API_KEY=

# Pyth price feed ID (32-byte hex string) (required)
PYTH_PRICE_FEED_ID=0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace

# Chain for Pyth oracle (e.g. ARBITRUM or ARBITRUM_SEPOLIA) (required)
PYTH_CHAIN=ARBITRUM

# Chainlink Data Feed contract address (AggregatorV3Interface) (required)
CHAINLINK_FEED_ADDRESS=0x639Fe6ab55C921f74e7fac1ee960C0B6293ba612

# Chain for Chainlink feed (e.g. ARBITRUM or ARBITRUM_SEPOLIA) (required)
CHAINLINK_CHAIN=ARBITRUM

# Chain for Uniswap V3 swaps (ARBITRUM, ARBITRUM_SEPOLIA, or ETHEREUM_SEPOLIA) (required)
UNISWAP_CHAIN=ARBITRUM

# Default Uniswap V3 slippage in basis points (e.g. 50 = 0.5%)
UNISWAP_DEFAULT_SLIPPAGE_BPS=50